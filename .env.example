# ============================================================
# Fairy Meadows Project — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ----- DATABASE -----
# Local dev: use a Neon free-tier PostgreSQL URL
# Vercel: paste your Neon DATABASE_URL in Vercel Environment Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ----- NEXTAUTH -----
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ----- ADMIN -----
# Admin panel login is handled via bcrypt in /api/admin/login
# Default credentials are seeded in prisma/seed.ts
# admin / murree2026  — change after first deploy!
