generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Flat {
  id           Int       @id @default(autoincrement())
  name         String
  layout       String
  type         String
  salePriceLac Float?
  rentPerNight Float?
  description  String
  features     String
  images       String
  videos       String
  status       String    @default("available")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inquiries    Inquiry[]
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  customerName String
  phone        String
  flatId       Int
  flat         Flat     @relation(fields: [flatId], references: [id])
  type         String
  checkIn      String?
  checkOut     String?
  guests       Int?
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
